defmodule Rclex.Pkgs.<%= module_name %> do
  @moduledoc false
  @behaviour Rclex.ActionBehaviour

  alias Rclex.Nif

  def type_support!() do
    Nif.<%= function_prefix %>_type_support!()
  end

  def feedback_message_type() do
    Rclex.Pkgs.<%= module_name %>_FeedbackMessage
  end

  def feedback_type() do
    Rclex.Pkgs.<%= module_name %>_Feedback
  end

  def goal_type() do
    Rclex.Pkgs.<%= module_name %>_Goal
  end

  def result_type() do
    Rclex.Pkgs.<%= module_name %>_Result
  end

  def get_result_request_type() do
    Rclex.Pkgs.<%= module_name %>_GetResultRequest
  end

  def get_result_response_type() do
    Rclex.Pkgs.<%= module_name %>_GetResultResponse
  end

  def send_goal_request_type() do
    Rclex.Pkgs.<%= module_name %>_SendGoalRequest
  end

  def send_goal_response_type() do
    Rclex.Pkgs.<%= module_name %>_SendGoalResponse
  end
end
